# Copy to .env. Do not commit .env or credential files.
# OCR engine for images and scanned PDFs: tesseract (free, local) or vision (Google Cloud).
OCR_ENGINE=tesseract
# Only needed if tesseract.exe is not on PATH or in C:\Program Files\Tesseract-OCR
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=eng
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternatively use: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
OCR_DB=documents.sqlite3
